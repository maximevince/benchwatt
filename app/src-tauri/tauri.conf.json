{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenOtii",
  "version": "0.1.0",
  "identifier": "dev.openotii.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "OpenOtii", "width": 1160, "height": 800, "minWidth": 760, "minHeight": 620 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": ["deb", "appimage"] }
}
