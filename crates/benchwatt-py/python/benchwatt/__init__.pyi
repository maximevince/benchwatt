from typing import Any
import builtins
import numpy as np
from numpy.typing import NDArray

class DeviceError(Exception): ...
class TimeoutError(builtins.TimeoutError): ...
class AlertError(Exception): ...

class Serial:
    """A serial port of this PC to record next to an instrument."""
    def __init__(self, port: str, baud: int = ..., *, data_bits: int = ..., parity: str = ..., stop_bits: int = ..., flow: str = ..., dtr: bool = ..., rts: bool = ...) -> None: ...

class Recording:
    @staticmethod
    def load(path: str) -> Recording: ...
    @property
    def duration(self) -> float: ...
    @property
    def channels(self) -> list[str]: ...
    @property
    def gaps(self) -> list[dict[str, float]]: ...
    def data(self, name: str, t0: float | None = ..., t1: float | None = ...) -> tuple[NDArray[np.float64], NDArray[np.float32]]: ...
    def stats(self, name: str, t0: float | None = ..., t1: float | None = ...) -> dict[str, float | int] | None: ...
    def charge_mah(self, t0: float | None = ..., t1: float | None = ...) -> float | None: ...
    def energy(self, t0: float | None = ..., t1: float | None = ...) -> dict[str, float] | None: ...
    def edges(self, t0: float | None = ..., t1: float | None = ...) -> list[dict[str, float | int]]: ...
    def bytes(self, name: str, t0: float | None = ..., t1: float | None = ...) -> list[tuple[float, builtins.bytes]]: ...
    def save(self, path: str) -> None: ...
    def export(self, path: str) -> None: ...

class Device:
    def __enter__(self) -> Device: ...
    def __exit__(self, exc_type: Any, exc_value: Any, traceback: Any) -> None: ...
    def close(self) -> None: ...
    @property
    def info(self) -> dict[str, Any]: ...
    @property
    def channels(self) -> list[dict[str, Any]]: ...
    @property
    def outputs(self) -> list[dict[str, Any]]: ...
    @property
    def settings(self) -> list[dict[str, Any]]: ...
    def get(self, key: str) -> Any: ...
    def set(self, key: str, value: Any) -> None: ...
    def set_voltage(self, volts: float, out: int | None = ...) -> None: ...
    def set_current_limit(self, amps: float, out: int | None = ...) -> None: ...
    def set_output(self, on: bool, out: int | None = ...) -> None: ...
    def output_state(self, out: int | None = ...) -> dict[str, Any]: ...
    @property
    def output(self) -> bool: ...
    @output.setter
    def output(self, on: bool) -> None: ...
    @property
    def voltage(self) -> float | None: ...
    @property
    def current_limit(self) -> float | None: ...
    def set_gpo(self, n: int, on: bool) -> None: ...
    def monitor(self) -> dict[str, float]: ...
    def alerts(self) -> list[dict[str, Any]]: ...
    def uart_open(self, baud: int) -> None: ...
    def uart_write(self, data: builtins.bytes) -> None: ...
    def uart_close(self) -> None: ...
    def serial_write(self, data: builtins.bytes) -> None: ...
    def start_recording(self, channels: list[str] | None = ..., digital: bool = ..., uart: int | None = ..., serial: Serial | None = ...) -> None: ...
    def stop_recording(self) -> Recording: ...
    def record(self, duration: float, channels: list[str] | None = ..., digital: bool = ..., uart: int | None = ..., serial: Serial | None = ...) -> Recording: ...

def devices() -> list[dict[str, str]]: ...
def open(device: str | None = ...) -> Device: ...
def Arc(port: str | None = ...) -> Device: ...
