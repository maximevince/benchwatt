from typing import Any, Literal
import builtins
import numpy as np
from numpy.typing import NDArray

class DeviceError(Exception): ...
class TimeoutError(builtins.TimeoutError): ...
class AlertError(Exception): ...

class Recording:
    @staticmethod
    def load(path: str) -> Recording: ...
    @property
    def duration(self) -> float: ...
    @property
    def channels(self) -> list[str]: ...
    @property
    def gaps(self) -> list[dict[str, float]]: ...
    def data(self, name: str, t0: float | None = ..., t1: float | None = ...) -> tuple[NDArray[np.float64], NDArray[np.float32]]: ...
    def stats(self, name: str, t0: float | None = ..., t1: float | None = ...) -> dict[str, float | int] | None: ...
    def charge_mah(self, t0: float | None = ..., t1: float | None = ...) -> float | None: ...
    def energy(self, t0: float | None = ..., t1: float | None = ...) -> dict[str, float] | None: ...
    def edges(self, t0: float | None = ..., t1: float | None = ...) -> list[dict[str, float | int]]: ...
    def uart(self, t0: float | None = ..., t1: float | None = ...) -> list[tuple[float, bytes]]: ...
    def save(self, path: str) -> None: ...
    def export(self, path: str) -> None: ...

class Arc:
    def __init__(self, port: str | None = ...) -> None: ...
    def __enter__(self) -> Arc: ...
    def __exit__(self, exc_type: Any, exc_value: Any, traceback: Any) -> None: ...
    def close(self) -> None: ...
    @property
    def info(self) -> dict[str, Any]: ...
    def set_voltage(self, volts: float) -> None: ...
    def set_current_limit(self, amps: float) -> None: ...
    def set_current_mode(self, mode: Literal["cutoff", "limit"]) -> None: ...
    @property
    def output(self) -> bool: ...
    @output.setter
    def output(self, on: bool) -> None: ...
    @property
    def voltage(self) -> float: ...
    @property
    def current_limit(self) -> float: ...
    def set_gpo(self, n: int, on: bool) -> None: ...
    def monitor(self) -> dict[str, float]: ...
    def alerts(self) -> list[dict[str, int | str]]: ...
    def uart_open(self, baud: int) -> None: ...
    def uart_write(self, data: bytes) -> None: ...
    def uart_close(self) -> None: ...
    def start_recording(self, channels: list[str], gpi: bool = ..., uart: bool = ...) -> None: ...
    def stop_recording(self) -> Recording: ...
    def record(self, duration: float, channels: list[str] | None = ..., gpi: bool = ..., uart: bool = ...) -> Recording: ...
